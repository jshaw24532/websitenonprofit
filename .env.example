# Stripe — card donations (production: use Stripe Elements; never store PAN/CVV)
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# The Giving Block — crypto, stock, DAF with automatic USD liquidation
# https://thegivingblock.com/crypto-donations/
# GIVING_BLOCK_API_KEY=
# NEXT_PUBLIC_GIVING_BLOCK_ENABLED=true
# NEXT_PUBLIC_GIVING_BLOCK_WIDGET_URL=

# Admin portal
ADMIN_EMAIL=admin@on3rdoutreach.org
ADMIN_PASSWORD=Admin@2026!
SESSION_SECRET=change-this-to-a-long-random-string

# Public site URL (used in reminder emails)
NEXT_PUBLIC_SITE_URL=http://localhost:1324

# SMTP — transactional emails (thank you, receipt, confirmation, reminder)
# Port 465 requires SMTP_SECURE=true
# SMTP_HOST=mail.on3rdoutreach.org
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=info@on3rdoutreach.org
# SMTP_PASS=
# SMTP_FROM=info@on3rdoutreach.org
